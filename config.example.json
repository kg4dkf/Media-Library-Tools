  "tmdb_api_key": "REPLACE_ME",

  "movies_root":     "H:/Movies",
  "mediaprep_dir":   "H:/_mediaprep",
  "duplicates_dir":  "H:/duplicates",

  "language": "en-US",

  "strip_collection_suffix": true,

  "hash_algo": "blake3",

  "extras_size_threshold_mb": 500,

  "confidence_auto":   75,
